# Copy to .env and adjust. Every value is optional; defaults are shown.
# Relative paths are resolved from the project root.

DATA_DIR=data
VECTOR_DB_DIR=vector_db

MAX_UPLOAD_MB=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Startup reconciliation only REPORTS vectors that belong to no indexed
# document. Set to true to delete them (inspect the report first).
PRUNE_ORPHAN_VECTORS=false

# Streamlit frontend -> backend URL
RAG_API_URL=http://127.0.0.1:8000

# Ollama. OLLAMA_HOST is also accepted. The health probe uses a short timeout
# so a hung model server does not stall the API.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_HEALTH_TIMEOUT=1
