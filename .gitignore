# ==================================================
# SECRETS & LOCAL CONFIGURATION
# ==================================================
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# ==================================================
# PYTHON
# ==================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==================================================
# VIRTUAL ENVIRONMENTS
# ==================================================
.venv/
venv/
env/
ENV/

# ==================================================
# LOCAL DATA & USER UPLOADS
# ==================================================
data/*
!data/uploads/
data/uploads/*
!data/uploads/.gitkeep

uploads/
uploaded_files/
documents/

# ==================================================
# DATABASES
# ==================================================
*.db
*.sqlite
*.sqlite3
documents.db
conversations.db

# ==================================================
# VECTOR DATABASE & PERSISTENCE
# ==================================================
vector_db/*
!vector_db/.gitkeep

chroma_db/
chromadb/
vectorstore/
vectors/
storage/

# ==================================================
# EVALUATION OUTPUTS
# ==================================================
evaluation/results/*
!evaluation/results/.gitkeep

evaluation/manual_reviews/*
!evaluation/manual_reviews/.gitkeep
!evaluation/manual_reviews/template.json

# ==================================================
# GENERATED REPORTS & EXPERIMENT OUTPUTS
